# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — NEVER expose to the browser. Server-side only
# (used by scripts/create-admin.mjs and any future admin API routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- WhatsApp Business Cloud API (planning delivery) ---
# All server-side. Never prefix these with NEXT_PUBLIC_. Step-by-step: docs/whatsapp-planning-setup.md
# Leave them empty and plannings simply stay "in app only".
#
# Permanent token from a Meta "System User" (NOT the 24-hour test token on the API Setup page)
WHATSAPP_ACCESS_TOKEN=
# The "Phone number ID" of your business number (a long number, not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Exact name of your approved template (header = image, body = {{1}} driver name, {{2}} date)
WHATSAPP_TEMPLATE_NAME=driver_planning
# Language code the template was approved in: en, en_US, es, fr, ...
WHATSAPP_TEMPLATE_LANG=en
# Webhook (delivery receipts): any long random string you invent, and your Meta App Secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional. Graph API version (default v23.0).
# WHATSAPP_GRAPH_VERSION=v23.0

# --- Planning ---
# Time zone used for "today" / "tomorrow" when picking a planning date (default America/Toronto)
# NEXT_PUBLIC_APP_TIMEZONE=America/Toronto

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
